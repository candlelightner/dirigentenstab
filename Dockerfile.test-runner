FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

LABEL org.opencontainers.image.source="https://github.com/candlelightner/dirigentenstab" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.description="Prebuilt CI and browser test runner for Dirigentenstab"

RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git gnupg tar \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/apache/cloudstack-cloudmonkey/releases/download/6.6.0/cmk.linux.x86-64 -o /usr/local/bin/cmk \
    && echo '9f4f92ebc3b1e6139d81a2b3f9e7f7c663d1806234ae0ab27cf77753c553d76b  /usr/local/bin/cmk' | sha256sum -c - \
    && chmod 755 /usr/local/bin/cmk

ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY requirements.lock pyproject.toml /opt/test-runner/
COPY scripts/test_runner.py /opt/test-runner/scripts/test_runner.py
COPY Dockerfile.test-runner /opt/test-runner/Dockerfile.test-runner

RUN python -m venv /opt/venv \
    && pip install --no-cache-dir "setuptools>=75" wheel \
    && pip install --no-cache-dir -r /opt/test-runner/requirements.lock \
    && python /opt/test-runner/scripts/test_runner.py extras-requirements /opt/test-runner/extras.txt --root /opt/test-runner \
    && pip install --no-cache-dir -c /opt/test-runner/requirements.lock -r /opt/test-runner/extras.txt \
    && pip check

RUN python -m playwright install --with-deps --only-shell --no-remove chromium firefox \
    && rm -rf /var/lib/apt/lists/*

RUN python /opt/test-runner/scripts/test_runner.py write-manifest /opt/test-runner/manifest.json --root /opt/test-runner

RUN git config --system --add safe.directory '*' \
    && chmod -R a+rX /ms-playwright /opt/test-runner \
    && chmod -R a+rwX /opt/venv

WORKDIR /work

[Unit]
Description=Dirigentenstab scoped SSH and native-SG guest routing
After=docker.service cloudstack-agent.service

[Service]
Type=oneshot
EnvironmentFile=/etc/dirigentenstab-network.env
ExecStart=/usr/bin/python3 /usr/local/libexec/dirigentenstab-guest-ssh.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Native CloudStack stays private. Use --existing to connect to another installation.
# Literal network values shared by native setup and installed host forwarding helpers.
CLOUDSTACK_BRIDGE=dscloud0
CLOUDSTACK_NETWORK=10.253.80.0/24
CLOUDSTACK_GATEWAY=10.253.80.1
CLOUDSTACK_SYSTEM_START=10.253.80.20
CLOUDSTACK_SYSTEM_END=10.253.80.40
CLOUDSTACK_GUEST_START=10.253.80.100
CLOUDSTACK_GUEST_END=10.253.80.220
APP_NETWORK=172.30.253.0/24
APP_ADDRESS=172.30.253.2
TAILSCALE_INTERFACE=tailscale0
CLOUDSTACK_URL=http://${CLOUDSTACK_GATEWAY}:8080/client/api
# Browser-facing native dashboard; blank hides the administrator-only quicklink.
CLOUDSTACK_UI_URL=
# Opt in during setup after the licensed host vGPU Manager is installed; policies default to deny.
ENABLE_GPU_CONTROL=false
# GPU_PARENT=0000:07:00.0
# Secure cookies require HTTPS. setup.sh creates a local certificate for localhost.
PUBLIC_ORIGIN=https://localhost:3000
# Optional unique name (a-z, 0-9, -; max 20) when several hubs share one CloudStack; set before first setup.
# INSTANCE_NAME=
# Hub login idle timeout in seconds (43200 = 12h): activity renews it; CloudStack expiry/revocation still applies.
SESSION_SECONDS=3600
BIND_ADDRESS=127.0.0.1
BIND_PORT=3000
IMAGE=ghcr.io/candlelightner/dirigentenstab:0.1.21
MASTER_KEY_PATH=./secrets/master_key
TLS_CERT_PATH=./secrets/tls.crt
TLS_KEY_PATH=./secrets/tls.key
# Narrow this to your actual CloudStack guest networks.
SSH_NETWORKS=${CLOUDSTACK_NETWORK}
# Used only by setup, never mounted in the application container.
CLOUDSTACK_BOOTSTRAP_CREDENTIALS_FILE=/var/lib/dirigentenstab/setup/cloudstack-admin.json

# Native CloudStack stays private. Use --existing to connect to another installation.
CLOUDSTACK_URL=http://10.253.80.1:8080/client/api
# Browser-facing native dashboard; blank hides the administrator-only quicklink.
CLOUDSTACK_UI_URL=
# Opt in during setup after the licensed host vGPU Manager is installed; policies default to deny.
ENABLE_GPU_CONTROL=false
# GPU_PARENT=0000:07:00.0
# Secure cookies require HTTPS. setup.sh creates a local certificate for localhost.
PUBLIC_ORIGIN=https://localhost:3000
# Hub login lifetime in seconds (43200 = 12h); CloudStack expiry/revocation still applies.
SESSION_SECONDS=3600
BIND_ADDRESS=127.0.0.1
BIND_PORT=3000
IMAGE=ghcr.io/candlelightner/dirigentenstab:0.1.12
MASTER_KEY_PATH=./secrets/master_key
TLS_CERT_PATH=./secrets/tls.crt
TLS_KEY_PATH=./secrets/tls.key
# Narrow this to your actual CloudStack guest networks.
SSH_NETWORKS=10.253.80.0/24
SSH_SOURCE_CIDR=10.253.80.1/32
# Used only by setup, never mounted in the application container.
CLOUDSTACK_BOOTSTRAP_CREDENTIALS_FILE=/var/lib/dirigentenstab/setup/cloudstack-admin.json
